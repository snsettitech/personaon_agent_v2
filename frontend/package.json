{
  "name": "frontend_new",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <25",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "build:vercel": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:e2e:prod-canary": "playwright test tests/e2e/prod_research_canary.spec.ts --project=chromium",
    "test:e2e:prod-canary:headed": "playwright test tests/e2e/prod_research_canary.spec.ts --project=chromium --headed",
    "prepare": "husky",
    "enforce:ui:single": "node scripts/enforce-single-twin.js --mode single-twin",
    "enforce:ui:strict": "node scripts/enforce-single-twin.js --mode strict",
    "enforce:analytics": "node scripts/enforce-onboarding-analytics.mjs"
  },
  "dependencies": {
    "@elevenlabs/react": "^1.1.0",
    "@google/generative-ai": "^0.21.0",
    "@mesh-gradient/react": "^1.5.0",
    "@playwright/test": "^1.57.0",
    "@radix-ui/react-alert-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-select": "^2.3.1",
    "@stripe/react-stripe-js": "^6.2.0",
    "@stripe/stripe-js": "^9.3.1",
    "@supabase/ssr": "0.9.0",
    "@supabase/supabase-js": "2.99.3",
    "@tailwindcss/typography": "^0.5.19",
    "driver.js": "^1.4.0",
    "framer-motion": "^12.38.0",
    "lenis": "^1.3.21",
    "lucide-react": "^1.8.0",
    "mammoth": "^1.8.0",
    "next": "^16.1.6",
    "pdf-parse": "^1.1.1",
    "posthog-js": "^1.364.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.3.14",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "tailwindcss": "^4",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ]
  }
}
