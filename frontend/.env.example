# PersonaOn AI — Frontend Environment Variables
# These are build-time env vars (NEXT_PUBLIC_ prefix makes them browser-visible).
# In production: set on Cloud Run service or as GitHub Actions secrets.
# For local dev: copy to frontend/.env.local

NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-jwt>
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# PostHog Analytics (optional — analytics disabled when key is absent)
NEXT_PUBLIC_POSTHOG_KEY=phc_<your-project-api-key>
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Stripe (get from Stripe dashboard > Developers > API keys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# /experience demo (server-side only — not NEXT_PUBLIC, never sent to the browser)
# Required for POST /api/demo/analyze and /api/demo/chat.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Feature flags (build-time defaults; per-user overrides via Supabase metadata)
# ---------------------------------------------------------------------------
# Workspace v2: the unified /workspace UX shell. Defaults to false.
# Set to "true" to default-enable for the build; users can still override per-account.
NEXT_PUBLIC_FLAG_WORKSPACE_V2=false

# Home v1 — persona-assistant Home (plan: plans/home-v1-assistant.md).
# OFF (default) → /dashboard redirects to meetings (current behavior).
# "true" → renders the assistant Home at /dashboard (fixes #227). Flip in staging first.
NEXT_PUBLIC_FLAG_ASSISTANT_HOME_V1=false
